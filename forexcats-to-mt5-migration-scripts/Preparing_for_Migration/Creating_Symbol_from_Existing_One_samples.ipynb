    "                    if symbol_request_result:\n",
    "                        symbol_path = symbol_request_result.Path\n",
    "                        print(f\"✅ Успешное создание {symbol_request_result.Symbol} символ находится в группе {symbol_path}\")\n",
    "                        new_folder = new_root_folder + symbol_path\n",
    "                        print(f\"new_folder = {new_folder}\")\n",
    "                        symbol_request_result.Path = new_folder\n",
    "                        symbol_update_result = admin.SymbolUpdate(symbol_request_result)\n",
    "                        if symbol_update_result:\n",
    "                            symbol_request_result = manager.SymbolRequest(new_symbol.Symbol)\n",
    "                            print(f\"✅ Успешное перемещение {symbol_request_result.Symbol} символ находится в группе {symbol_request_result.Path}\")\n",
    "                else: print(f\"❌ Ошибка: символ {currency_name_suffix} не найден на сервере.\")\n",
    "\n",
    "            try: del symbol_request_result, symbol_update_result, symbol_exist, new_symbol, symbol_name, currency_name_suffix, symbol_path\n",
    "            except NameError as e: print(f\"❌ ERROR: Ошибка удаления переменных: {e}\")\n",
    "\n",
    "        else:\n",
    "            print(\"❌ ERROR: символ не найден\", symbol_mapping)\n",
    "            not_found_symbol_in_mt_df = pd.concat([not_found_symbol_in_mt_df, pd.DataFrame([row])], ignore_index=True)\n",
    "    \n",
    "    imported[\"mt5_disconnect_with_control\"](admin, manager, return_admin, return_manager)       # Закрываем соединение с сервером MetaTrader 5\n",
    "\n",
    "imported[\"save_data_log_work_file\"](not_found_symbol_in_mt_df, \"not_found_symbol_in_mt_df.csv\", directory_data_temp_files, directory_data_log_files)\n",
    "imported[\"pd_set_option\"](\" \\n Таблица Символов не найденных на стороне МТ5\", not_found_symbol_in_mt_df, 3)"
   ]
