   "source": [
    "# Замена Международного названия символа на Описание\n",
    "for a in symbol_array:\n",
    "    if a.Path.startswith('CRYPTO'): a.International = a.Description"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Замена описания символа на имя символов\n",
    "for a in symbol_array:\n",
    "    if a.Path.startswith('CRYPTO\\\\Crypto'): a.Description = a.Symbol"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Выделяем Символвы, Определяем концовку которую нужно обрезать # Обрезаем последние два символа в ОПИСАНИИ\n",
    "for a in symbol_array:                                                      # Проход по элементам массива\n",
    "    if a.Path.startswith('FOREX'):\n",
    "        if a.Description.endswith('.i'): a.Description = a.Description[:-2]"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Вставляем \" / \" посередине \n",
    "for a in symbol_array:\n",
    "    if a.Path.startswith('CRYPTO\\\\Crypto - USDT'):\n",
    "        if len(a.Description) > 1:\n",
    "            a.Description = a.Description[:-4] + ' / ' + a.Description[-4:]"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# удаление символа \"/\", если он присутствует в строке\n",
    "for a in symbol_array:\n",
    "    if a.Path.startswith('CRYPTO\\\\Crypto - USDT'):\n",
    "        a.Description = a.Description.replace(\" / \", \"\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# элементы из массива symbol_array, у которых значение Description встречается более одного раза\n",
    "\"\"\"Чтобы отобрать элементы из массива symbol_array, у которых значение Description встречается более одного раза,\n",
    "    и составить список значений Symbol этих элементов, можно выполнить следующие шаги:\n",
    "    Пройтись по массиву и собрать количество вхождений каждого значения Description.\n",
    "    Отобрать те Description, которые встречаются более одного раза.\n",
    "    Составить список соответствующих Symbol.\n",
    "\"\"\"\n",
    "description_count = {}                              # Словарь для подсчета вхождений Description\n",
    "for a in symbol_array:                              # Подсчет вхождений Description\n",
    "    if a.Path.startswith('FOREX'):\n",
    "        description = a.Description\n",
    "        if description in description_count:\n",
    "            description_count[description] += 1\n",
    "        else:\n",
    "            description_count[description] = 1\n",
    "\n",
    "symbols = []                                        # Список для хранения Symbol значений\n",
    "for a in symbol_array:                              # Отбор Symbol для повторяющихся Description\n",
    "    if a.Path.startswith('FOREX') and description_count.get(a.Description, 0) > 1:\n",
    "        symbols.append(a.Symbol)\n",
    "\n",
    "print(\"Колличество элементов symbol_array, у которых значение Description встречается более одного раза:\", len(symbols), \"\\n\",\n",
    "      \"Список:\", symbols)"
   ]
