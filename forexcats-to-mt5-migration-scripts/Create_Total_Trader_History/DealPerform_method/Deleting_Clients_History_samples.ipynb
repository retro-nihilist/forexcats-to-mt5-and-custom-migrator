    "import MT5Manager                           # подключаем библиотеку\n",
    "manager = MT5Manager.ManagerAPI()           # создаем менеджерский интерфейс\n",
    "admin = MT5Manager.AdminAPI()               # создаем администраторский интерфейс\n",
