    "\"\"\"filtr_df = statement_format_df[statement_format_df[\"position_id\"] == 115419]\n",
    "pd_set_option(\"statement_df[\"\"] ==\", filtr_df, 3)\"\"\""
   ]
  },
  {
   "cell_type": "code",
