    "# Запрос с МТ5 сервера торговых инстрментов доступных для указаной клиентской группы (отправка/обновление конфигураций происходит только через Администраторский интерфейс)\n",
    "# `````````````````````````````````````````````````````````````````````````````````` \n",
    "mask    = \"*\"                                                   # маска\n",
    "group   =\"demo\\\\technical_dev\\\\migration_zero_usd\"               # имя группы\n",
    "\n",
    "manager = manager_connect()\n",
    "if manager:\n",
    "    array_symbols = manager.SymbolRequestArray(mask, group)\n",
    "    manager_disconnect(manager)\n",
    "\n",
    "array_symbols_df = df_array_symbols(array_symbols)\n",
    "pd_set_option(\"\\n ДФ конфигураций торговых инструментов\", array_symbols_df, 10)\n",
